// Dr.Diet - Prisma Schema
// Database: PostgreSQL (Neon or Supabase)
// Run: npx prisma generate && npx prisma migrate dev
//
// Supabase: if pooler fails locally, use "Direct connection" from the dashboard
// (db.<ref>.supabase.co:5432). See .env.example and README-SETUP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SITE SETTINGS (Singleton) ============
model SiteSettings {
  id    String @id @default("singleton")
  
  // Contact & Social
  phoneNumber    String?
  instagramUrl   String?
  instagramHandle String?
  
  // Menu PDF
  menuPdfUrl     String?
  
  // Order links
  orderOnBeeorderUrl String?
  orderOnMovoUrl     String?
  
  // Location
  googleMapsEmbedUrl String?  // legacy: plain embed URL
  googleMapsLinkUrl  String?
  mapsEmbedHtml      String?  // full iframe HTML from Google (Share → Embed)
  locationText       String?  // legacy: single location line
  locationEn         String?  // Find us location (English)
  locationAr         String?  // Find us location (Arabic)
  
  // Our Most Loved Plates section (bilingual title + subtitle)
  lovedPlatesTitleEn    String?
  lovedPlatesTitleAr   String?
  lovedPlatesSubtitleEn String?  @db.Text
  lovedPlatesSubtitleAr String?  @db.Text

  // Dr.Diet Market section (bilingual title + subtitle)
  marketTitleEn    String?
  marketTitleAr   String?
  marketSubtitleEn String?  @db.Text
  marketSubtitleAr String?  @db.Text

  // Videos / Reels section (bilingual title + subtitle)
  videosTitleEn    String?
  videosTitleAr   String?
  videosSubtitleEn String?  @db.Text
  videosSubtitleAr String?  @db.Text

  // Section visibility toggles
  showHero        Boolean @default(true)
  showMenu        Boolean @default(true)
  showPlates      Boolean @default(true)
  showScience     Boolean @default(true)
  showVideos      Boolean @default(true)
  showTestimonials Boolean @default(true)
  showPlans       Boolean @default(true)
  showContact     Boolean @default(true)
  
  // Science section optional content (JSON for flexibility)
  scienceContent  Json?
  
  updatedAt DateTime @updatedAt
}

// ============ MENU ============
model Category {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  order         Int      @default(0)
  meals         Meal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Meal {
  id            String    @id @default(cuid())
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  proteinG      Int?
  carbsG        Int?
  calories      Int?
  price         String?
  imageUrl      String
  order         Int       @default(0)
  link          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mealTags   MealTag[]
  heroSlots  HeroFeatured[]
}

model MealTag {
  id      String  @id @default(cuid())
  mealId  String
  meal    Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  labelEn String
  labelAr String
  tone    String  // "green" | "orange"
  order   Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ HERO (Exactly 3 meals, CMS-driven) ============
// Single row for hero headline/description (bilingual)
model HeroContent {
  id            String   @id @default("singleton")
  slogan        String   @default("")  // EN
  sloganAr      String?  // AR
  title         String   @default("")  // EN
  titleAr       String?  // AR
  description   String   @db.Text      // EN
  descriptionAr String?  @db.Text      // AR
  ctaLabelEn    String?  // e.g. "Order Now"
  ctaLabelAr    String?  // e.g. "اطلب الآن"
  updatedAt     DateTime @updatedAt
}

// Fallback: if DB has < 3 active HeroMeals, use static seed in public/images (bilingual)
model HeroMeal {
  id        String   @id @default(cuid())
  title     String   // display name EN
  titleAr   String?  // AR
  subtitle  String?  // EN e.g. "Energy Dish"
  subtitleAr String? // AR
  calories  Int?
  protein   Int?
  badge     String?  // EN e.g. "Rotating signature meal"
  badgeAr   String?  // AR
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroFeatured {
  id        String   @id @default(cuid())
  slotIndex Int      @unique // 0, 1, 2
  title     String
  macros    String
  tags      String[]
  imageUrl  String
  link      String?
  order     Int      @default(0)
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ OUR MOST LOVED PLATES ============
model Plate {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?  // categoryLabel
  description    String?  @db.Text
  imageUrl       String
  galleryUrls    String[]
  protein        Int
  calories       Int
  carbs          Int?
  tags           String[] // badges
  ingredients    String[] // or ingredients text split
  allergens      String[]
  nutritionFacts Json?    // { fat?, fiber?, sugar? } or text
  isMostLoved    Boolean  @default(false)
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// CMS-managed "Our Most Loved Plates" (bilingual EN/AR)
model LovedPlate {
  id             String         @id @default(cuid())
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  titleEn        String
  titleAr        String
  subtitleEn     String?
  subtitleAr     String?
  descriptionEn  String?        @db.Text
  descriptionAr  String?        @db.Text
  imageUrl       String
  galleryUrls    String[]       // optional, max 6
  proteinG       Int?
  carbsG         Int?
  calories       Int?
  ingredientsEn  String?        @db.Text
  ingredientsAr  String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tags           LovedPlateTag[]
}

model LovedPlateTag {
  id        String     @id @default(cuid())
  plateId   String
  plate     LovedPlate @relation(fields: [plateId], references: [id], onDelete: Cascade)
  labelEn   String
  labelAr   String
  tone      String     // "green" | "orange"
  sortOrder Int        @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============ VIDEOS / REELS (max 5 total) ============
model Video {
  id         String   @id @default(cuid())
  titleEn    String?
  titleAr    String?
  videoUrl   String   // Blob URL after upload
  posterUrl  String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ TESTIMONIALS ============
model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String?  // optional title e.g. "Gym Member"
  text       String   @db.Text // quote/content
  rating     Int      @default(5) // 1-5
  avatarUrl  String?
  avatarColor String? // optional; if null, derive from name initial
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ SUBSCRIPTION PLANS ============
model SubscriptionPlan {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  isPopular  Boolean  @default(false)
  titleEn    String
  titleAr    String
  subtitleEn String?
  subtitleAr String?
  featuresEn Json     // array of strings
  featuresAr Json     // array of strings
  weeklyPrice  Int?   // SYP; at least one of weekly/monthly required (validated in API)
  monthlyPrice Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id            String        @id @default(cuid())
  title         String
  includes      String        // subtitle
  weeklyPrice   Int
  monthlyPrice  Int
  currency      String        @default("SYP")
  isPopular     Boolean       @default(false)
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  features      PlanFeature[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PlanFeature {
  id       String  @id @default(cuid())
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  text     String
  included Boolean @default(true)
  order    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ DR.DIET MARKET ============
model MarketCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String?  @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MarketItem[]

  @@index([isActive])
}

model MarketItem {
  id             String   @id @default(cuid())
  categoryId     String
  category       MarketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  nameEn         String
  nameAr         String
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text

  price    Int?    // SYP, integer
  image    String  // blob url, required

  protein  Int?
  carbs    Int?
  calories Int?

  order    Int      @default(0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, order])
  @@index([isActive])
}
